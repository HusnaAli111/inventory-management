<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Products</title>
            <link rel="stylesheet" href="/css/style.css">

</head>
<body>
    <div class="topbar">

        <div class="logo">
            Inventory System
        </div>

        <div class="menu">
            ☰
        </div>

    </div>


    <!-- Sidebar -->

    <div class="sidebar">

        <a href="/dashboard">Dashboard</a>

        <a href="/products">Products</a>

        <a href="/stock/new">Stock Movement</a>

        <% if(user && user.role === 'admin'){ %>
        <a href="/categories">Categories</a>
        <% } %>

        <a href="/auth/sign-out">Sign Out</a>

    </div>


    <div class="main">

        <div class="products-page">

            <div class="products-header">

                <div>
                    <h1>Products</h1>
                    <p>Manage your inventory products</p>
                </div>

                <a href="/products/new" class="add-product-button">
                    + Add Product
                </a>

            </div>


            <div class="products-list">

                <% for(let product of products){ %>

                    <div class="product-card">

                        <div class="product-image">
                                <img src="/<%= product.picture %>" alt="<%= product.name %>">

                        </div>

                        <div class="product-info">

                            <h2>
                                <%= product.name %>
                            </h2>

                            <p class="product-price">
                                <%= product.price %> BHD
                            </p>

                            <a href="/products/<%= product._id %>" class="view-product">
                                View Product →
                            </a>

                        </div>

                    </div>

                <% } %>

            </div>

        </div>

    </div>
<script src="/js/count.js"></script>
<script> window.chtlConfig = { chatbotId: "8716758546" } </script>
<script async data-id="8716758546" id="chtl-script" type="text/javascript" src="https://chatling.ai/js/embed.js"></script>
</body>
</html>