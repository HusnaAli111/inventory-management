<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Sign In</title>
  <link rel="stylesheet" href="/css/style.css">
</head>

<body>

  <div class="signin-page">

    <div class="signin-box">

      <!-- Left side -->
      <div class="signin-left">

        <h1>Inventory<br>System</h1>

        <p>
          Manage your products, stock and categories
          all in one place.
        </p>

        <div class="signin-features">

          <div>
            <span>📦</span>
            <p>Manage Products</p>
          </div>

          <div>
            <span>📊</span>
            <p>Track Stock</p>
          </div>

          <div>
            <span>🗂</span>
            <p>Organize Categories</p>
          </div>

        </div>

      </div>


      <!-- Right side -->
      <div class="signin-right">

        <h1>Welcome Back</h1>

        <p class="signin-subtitle">
          Sign in to your account
        </p>

        <form action="/auth/sign-in" method="POST">

          <label for="username">
            Username
          </label>

          <input type="text" name="username" id="username">

          <label for="password">
            Password
          </label>

          <input type="password" name="password" id="password">

          <button type="submit">
            Sign In
          </button>

        </form>

        <p class="signup-text">
          Don't have an account?
          <a href="/auth/sign-up">Create Account</a>
        </p>

      </div>

    </div>

  </div>

</body>

</html>