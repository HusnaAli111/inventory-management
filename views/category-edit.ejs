<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
        <link rel="stylesheet" href="/css/style.css">

</head>
<body>
     <div class="topbar">

        <div class="logo">
            Inventory System
        </div>

        <div class="menu">
            ☰
        </div>

    </div>


    <!-- Sidebar -->

    <div class="sidebar">

        <a href="/">Dashboard</a>

        <a href="/products">Products</a>

        <a href="/stock/new">Stock Movement</a>

        <% if(user && user.role === 'admin'){ %>
        <a href="/categories">Categories</a>
        <% } %>

        <a href="/auth/sign-out">Sign Out</a>

    </div>

    <div class="main">

        <div class="edit-category-page">

            <div class="edit-category-header">

                <div class="edit-category-icon">
                    ✏️
                </div>

                <h1>Edit Category</h1>

                <p>Update the name of this category.</p>

            </div>


            <form action="/categories/<%= category._id %>?_method=PUT" method="POST">

                <label for="name">Category Name</label>

                <input
                    type="text"
                    name="name"
                    id="name"
                    value="<%= category.name %>"
                >

                <button type="submit" class="update-category-button">
                    Update Category →
                </button>

            </form>


            <form action="/categories/<%= category._id %>?_method=DELETE" method="POST">

                <button type="submit" class="delete-category-button">
                    Delete Category
                </button>

            </form>

        </div>

    </div>

</body>
</html>