<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
    <link rel="stylesheet" href="/css/style.css">
</head>

<body>
    <div class="topbar">

        <div class="logo">
            Inventory System
        </div>

        <div class="menu">
            ☰
        </div>

    </div>


    <!-- Sidebar -->

    <div class="sidebar">

        <a href="/dashboard">Dashboard</a>

        <a href="/products">Products</a>

        <a href="/stock/new">Stock Movement</a>

        <% if(user && user.role==='admin' ){ %>
            <a href="/categories">Categories</a>
            <% } %>

                <a href="/auth/sign-out">Sign Out</a>

    </div>
    <div class="main">

        <div class="add-category-page">

            <div class="add-category-header">

                <div class="category-big-icon">
                    +
                </div>

                <h1>Add Category</h1>

                <p>Create a new category for your products.</p>

            </div>


            <form action="/categories" method="POST">

                <label for="name">Category Name</label>

                <input type="text" name="name" id="name" placeholder="Enter category name">


                <button type="submit">
                    Add Category →
                </button>

            </form>

        </div>

    </div>
    <script src="/js/count.js"></script>
    <script> window.chtlConfig = { chatbotId: "8716758546" } </script>
    <script async data-id="8716758546" id="chtl-script" type="text/javascript"
        src="https://chatling.ai/js/embed.js"></script>
</body>

</html>