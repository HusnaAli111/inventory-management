<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Edit Product</title>
</head>

<body>

    <h1>Edit Product</h1>

        <form action="/products/<%= product._id %>?_method=PUT" method="POST">

        <label for="name">Product Name:</label>
        <input type="text" id="name" name="name" value="<%=product.name%>">
        <br><br>

        <label for="description">Description:</label>
        <input id="description" name="description" value="<%=product.description%>">

        <br><br>

        <label for="price">Price:</label>
        <input type="number" id="price" name="price" value="<%=product.price%>">

        <br><br>

        <label for="quantity">Quantity:</label>
        <input type="number" id="quantity" name="quantity" value="<%=product.quantity%>">

        <br><br>

        <label for="minStock">Minimum Stock:</label>
        <input type="number" id="minStock" name="minStock" value="<%=product.minStock%>">

        <br><br>


        <br><br>

        <button type="submit">Update Product</button>

    </form>

</body>
</html>
