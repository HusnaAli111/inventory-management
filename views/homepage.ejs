<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Home</title>
    <link rel="stylesheet" href="/css/style.css">
    <!-- <link rel="stylesheet" href="/neo-charts/neo-charts.css"> -->
</head>

<body>
    <!-- <%- include('./partials/navbar') %> -->

    <!-- Top Bar -->

    <div class="topbar">

        <div class="logo">
            Inventory System
        </div>

        <div class="menu">
            ☰
        </div>

    </div>


    <!-- Sidebar -->

    <div class="sidebar">

        <a href="/dashboard">Dashboard</a>

        <a href="/products">Products</a>

        <a href="/stock/new">Stock Movement</a>

        <% if(user && user.role === 'admin'){ %>
        <a href="/categories">Categories</a>
        <% } %>

        <a href="/auth/sign-out">Sign Out</a>

    </div>


    <!-- Main Content -->

    <!-- <div class="main">

    <h1>Dashboard</h1>

    <p>Welcome to the Inventory Management System</p> -->

    <div class="main">

        <div class="dashboard-header">

            <h1>Dashboard</h1>

            <a href="/products/new" class="add-button">
                + Add Product
            </a>

        </div>
        <div class="cards">

            <div class="card blue">
                <h2>
                    <%= products.length %>
                </h2>
                <p>Products</p>
            </div>

            <div class="card green">
                <h2><%= categories.length %></h2>
                <p>Categories</p>
            </div>

            <div class="card orange">
                <h2><%= stock %></h2>
                <p>Stock In</p>
            </div>


        </div>
<div class="recent-products">

            <h2>Recent Products</h2>
            <!-- //table section -->
            <table>

                <tr>
                    <th>Product</th>
                    <th>Price</th>
                    <th>Quantity</th>
                    <th>Category</th>
                    <th></th>
                </tr>

                <% for(let product of products){ %>

                    <tr>

                        <td>
                            <%= product.name %>
                        </td>

                        <td>
                            <%= product.price %> BHD
                        </td>

                        <td>
                            <%= product.quantity %>
                        </td>

                        <td>
                            <%= product.category ? product.category.name : "No Category" %>
                        </td>

                        <td>

                            <a href="/products/<%= product._id %>" class="view-button">View</a>

                            <a href="/products/<%= product._id %>/edit" class="edit-button">Edit</a>
                    </tr>

                    </td>

                    <% } %>

            </table>

        </div>
        
        </div>
    </div>

    </div>
<!-- <script src="/neo-charts/neo-charts.js"></script> -->
</body>

</html>