<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Add Product</title>
    <script defer src='/projects/project-2/public/js/script.js'></script>
        <link rel="stylesheet" href="/css/style.css">

</head>

<body>
     <div class="topbar">

        <div class="logo">
            Inventory System
        </div>

        <div class="menu">
            ☰
        </div>

    </div>


    <!-- Sidebar -->

    <div class="sidebar">

        <a href="/">Dashboard</a>

        <a href="/products">Products</a>

        <a href="/stock/new">Stock Movement</a>

        <% if(user && user.role === 'admin'){ %>
        <a href="/categories">Categories</a>
        <% } %>

        <a href="/auth/sign-out">Sign Out</a>

    </div>

    <div class="main">

        <div class="product-page">

            <div class="product-header">
                <h1>Add New Product</h1>
                <p>Create a new product and add it to your inventory.</p>
            </div>

            <form action="/products" method="POST" enctype="multipart/form-data">

                <div class="product-content">

                    <div class="image-section">

                        <div class="image-icon">
                            +
                        </div>

                        <h2>Product Image</h2>

                        <p>Upload an image for your product</p>

                        <input type="file" id="image" name="image" accept="image/*">

                    </div>


                    <div class="details-section">

                        <label for="name">Product Name</label>
                        <input type="text" id="name" name="name">


                        <label for="description">Description</label>
                        <input type="text" id="description" name="description">


                        <div class="small-fields">

                            <div>
                                <label for="price">Price</label>
                                <input type="number" id="price" name="price">
                            </div>

                            <div>
                                <label for="quantity">Quantity</label>
                                <input type="number" id="quantity" name="quantity">
                            </div>

                        </div>


                        <label for="minStock">Minimum Stock</label>
                        <input type="number" id="minStock" name="minStock">


                        <label for="category">Category</label>

                        <select name="category" id="category">

                            <% for(let category of categories){ %>

                                <option value="<%= category._id %>">
                                    <%= category.name %>
                                </option>

                            <% } %>

                        </select>


                        <button type="submit">
                            Add Product →
                        </button>

                    </div>

                </div>

            </form>

        </div>

    </div>

</body>

</html>