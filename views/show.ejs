<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>view deatils of the project</title>
            <link rel="stylesheet" href="/css/style.css">

</head>

<body>
    <div class="topbar">

        <div class="logo">
            Inventory System
        </div>

        <div class="menu">
            ☰
        </div>

    </div>


    <!-- Sidebar -->

    <div class="sidebar">

        <a href="/">Dashboard</a>

        <a href="/products">Products</a>

        <a href="/stock/new">Stock Movement</a>

        <% if(user && user.role === 'admin'){ %>
        <a href="/categories">Categories</a>
        <% } %>

        <a href="/auth/sign-out">Sign Out</a>

    </div>

    <div class="main">

        <div class="product-details">

            <div class="details-header">
                <h1>Product Details</h1>
                <p>View information about this product</p>
            </div>


            <div class="details-content">

                <div class="details-image">

                    <img src="/<%= product.picture %>" alt="<%= product.name %>">

                </div>

                <div class="details-info">

                    <h2>
                        <%= product.name %>
                    </h2>

                    <p class="description">
                        <%= product.description %>
                    </p>


                    <div class="info-boxes">

                        <div class="info-box price-box">
                            <p>Price</p>
                            <h3>
                                <%= product.price %> BHD
                            </h3>
                        </div>

                        <div class="info-box quantity-box">
                            <p>Quantity</p>
                            <h3>
                                <%= product.quantity %>
                            </h3>
                        </div>

                    </div>


                    <div class="details-buttons">

                        <a href="/products/<%= product._id %>/edit" class="edit-product">
                            Edit Product
                        </a>


                        <form action="/products/<%= product._id %>?_method=DELETE" method="POST">

                            <button type="submit" class="delete-product">
                                Delete Product
                            </button>

                        </form>

                    </div>

                </div>

            </div>

        </div>

    </div>

</body>

</html>